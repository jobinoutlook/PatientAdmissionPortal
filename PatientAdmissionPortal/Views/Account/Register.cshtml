@using PatientAdmissionPortal.ViewModels
@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm p-4">
      <h4 class="mb-3">Create an account</h4>
      <form asp-action="Register" method="post" id="registerForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
          <label asp-for="FullName" class="form-label"></label>
          <input asp-for="FullName" class="form-control" placeholder="e.g. Anita Nair" autocomplete="name" />
          <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Email" class="form-label"></label>
          <div class="input-group">
            <input asp-for="Email" class="form-control" type="email" placeholder="e.g. name@example.com" autocomplete="email" />
            <button type="button" class="btn btn-outline-primary" id="sendCodeBtn">Send code</button>
          </div>
          <span asp-validation-for="Email" class="text-danger"></span>
          <div id="codeMsg" class="form-text"></div>
        </div>

        <div class="mb-3">
          <label asp-for="Code" class="form-label"></label>
          <input asp-for="Code" class="form-control" maxlength="6" inputmode="numeric" pattern="[0-9]{6}"
                 autocomplete="one-time-code" placeholder="6-digit code from your email" />
          <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Password" class="form-label"></label>
          <input asp-for="Password" class="form-control" autocomplete="new-password" />
          <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter and a digit.</div>
          <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="ConfirmPassword" class="form-label"></label>
          <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
          <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button class="btn btn-primary w-100">Register</button>
      </form>
      <p class="mt-3 mb-0 text-center">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
  </div>
</div>

<script>
(function () {
  var form = document.getElementById('registerForm');
  var btn = document.getElementById('sendCodeBtn');
  var msg = document.getElementById('codeMsg');
  var emailInput = form.querySelector('[name="Email"]');
  var nameInput = form.querySelector('[name="FullName"]');
  var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
  var timer = null;

  function show(text, ok) {
    msg.textContent = text;
    msg.className = 'form-text ' + (ok ? 'text-success' : 'text-danger');
  }

  function cooldown(seconds) {
    var left = seconds;
    clearInterval(timer);
    btn.disabled = true;
    btn.textContent = 'Resend in ' + left + 's';
    timer = setInterval(function () {
      left--;
      if (left <= 0) {
        clearInterval(timer);
        btn.disabled = false;
        btn.textContent = 'Resend code';
      } else {
        btn.textContent = 'Resend in ' + left + 's';
      }
    }, 1000);
  }

  btn.addEventListener('click', async function () {
    var email = emailInput.value.trim();
    if (!email) { show('Enter your email address first.', false); emailInput.focus(); return; }

    btn.disabled = true;
    btn.textContent = 'Sending...';
    try {
      var body = new URLSearchParams({
        email: email,
        fullName: nameInput.value.trim(),
        __RequestVerificationToken: token
      });
      var res = await fetch('@Url.Action("SendRegistrationCode", "Account")', { method: 'POST', body: body });
      var data = await res.json();
      show(data.message, data.ok);
      if (data.ok) {
        cooldown(60);
        form.querySelector('[name="Code"]').focus();
      } else if (data.retryAfter) {
        cooldown(data.retryAfter);
      } else {
        btn.disabled = false;
        btn.textContent = 'Send code';
      }
    } catch (e) {
      show('Network error. Please try again.', false);
      btn.disabled = false;
      btn.textContent = 'Send code';
    }
  });
})();
</script>
