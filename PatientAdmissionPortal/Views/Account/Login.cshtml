@using PatientAdmissionPortal.ViewModels
@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm p-4">
      <h4 class="mb-3">Log in</h4>
      <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3">
          <label asp-for="Email" class="form-label"></label>
          <input asp-for="Email" class="form-control" type="email" placeholder="admin@patientportal.com" autocomplete="email" />
          <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
          <label asp-for="Password" class="form-label"></label>
          <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Admin123*" />
          <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
          <input asp-for="RememberMe" class="form-check-input" />
          <label asp-for="RememberMe" class="form-check-label"></label>
        </div>
        <button class="btn btn-primary w-100">Log in</button>
      </form>
      <p class="mt-3 mb-0 text-center">New here? <a asp-action="Register">Create an account</a></p>
    </div>
  </div>
</div>
