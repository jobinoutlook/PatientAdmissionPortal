@model Admission
@{
    ViewData["Title"] = "New admission";
}
<h3 class="mb-3">New admission request</h3>
<form asp-action="Create" method="post" class="card shadow-sm p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <h6 class="text-primary">Patient details</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" /><span asp-validation-for="DateOfBirth" class="text-danger"></span></div>
        <div class="col-md-3">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select" asp-items='new SelectList(new[] { "Female", "Male", "Other" })'><option value="">Select</option></select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" type="tel" placeholder="e.g. 9876543210" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" placeholder="e.g. name@example.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6"><label asp-for="EmergencyContactName" class="form-label"></label><input asp-for="EmergencyContactName" class="form-control" /><span asp-validation-for="EmergencyContactName" class="text-danger"></span></div>
        <div class="col-md-6">
            <label asp-for="EmergencyContactPhone" class="form-label"></label>
            <input asp-for="EmergencyContactPhone" class="form-control" type="tel" placeholder="e.g. 9876500000" />
            <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
        </div>
    </div>
    <h6 class="text-primary">Admission details</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label asp-for="Department" class="form-label"></label>
            <select asp-for="Department" class="form-select" asp-items="new SelectList(Admission.Departments)"><option value="">Select</option></select>
            <span asp-validation-for="Department" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<AdmissionType>()"></select>
        </div>
        <div class="col-12"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" rows="3" class="form-control"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="InsuranceProvider" class="form-label"></label><input asp-for="InsuranceProvider" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="InsuranceId" class="form-label"></label><input asp-for="InsuranceId" class="form-control" /></div>
    </div>
    <div><button class="btn btn-primary">Submit request</button> <a class="btn btn-link" asp-action="Index">Cancel</a></div>
</form>
