<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Patient Admission Portal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-primary mb-4">
  <div class="container">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">🏥 Patient Admission Portal</a>
    <div class="ms-auto d-flex align-items-center">
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a class="btn btn-outline-light btn-sm me-1" asp-controller="Admissions" asp-action="Index">Admissions</a>
        <a class="btn btn-light btn-sm me-3" asp-controller="Admissions" asp-action="Create">+ New admission</a>
        <span class="navbar-text text-white me-2 small">@User.Identity.Name</span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
          <button class="btn btn-outline-light btn-sm">Log out</button>
        </form>
      }
      else
      {
        <a class="btn btn-outline-light btn-sm me-1" asp-controller="Account" asp-action="Login">Log in</a>
        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Register">Register</a>
      }
    </div>
  </div>
</nav>
<main class="container pb-5">
  @if (TempData["Msg"] is string m) { <div class="alert alert-success">@m</div> }
  @if (TempData["Err"] is string e) { <div class="alert alert-danger">@e</div> }
  @RenderBody()
</main>
</body>
</html>
